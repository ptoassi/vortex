---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Vortex Refrigeração Industrial"
  description="Projetos, instalação e manutenção de sistemas de refrigeração industrial."
>
  <main class="mx-auto max-w-7xl px-6 py-20">
    <h1 class="text-5xl font-bold">
      Vortex Refrigeração Industrial
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-gray-600">
      Especialistas em refrigeração industrial, câmaras frias,
      chillers, VRF e projetos personalizados.
    </p>
  </main>
</BaseLayout>