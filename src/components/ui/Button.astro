---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
}

const {
  href = "#",
  variant = "primary",
} = Astro.props;

const styles = {
  primary:
    "bg-sky-600 text-white hover:bg-sky-700",

  secondary:
    "border border-white/30 text-white hover:bg-white/10",
};
---

<a
  href={href}
  class={`inline-flex items-center rounded-lg px-6 py-3 font-semibold transition ${styles[variant]}`}
>
  <slot />
</a>