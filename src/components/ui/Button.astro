---
interface Props{
  href:string;
  variant?:"primary"|"secondary";
}

const{
  href,
  variant="primary"
}=Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-md px-7 py-3 font-semibold transition duration-300",

    variant==="primary"
      ?"bg-[#F58220] hover:bg-[#dd741d] text-white"

      :"border border-white text-white hover:bg-white hover:text-[#0B2E4F]"
  ]}

>

  <slot/>

</a>