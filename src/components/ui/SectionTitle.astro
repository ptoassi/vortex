---
interface Props{
  title:string;
  subtitle?:string;
  center?:boolean;
}

const{
  title,
  subtitle,
  center=false
}=Astro.props;
---

<div class:list={[center && "text-center","mb-12"]}>

  <h2 class="text-4xl font-bold text-slate-800">

    {title}

  </h2>

  {subtitle && (

    <p class="mt-4 text-slate-600 max-w-3xl">

      {subtitle}

    </p>

  )}

</div>