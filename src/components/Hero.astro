---
import Container from "./ui/Container.astro";

import heroImage from "@assets/hero/hero-placeholder.webp";
import Button from "@components/ui/Button.astro";
---

<section
  id="home"
  class="relative overflow-hidden bg-[#08233D] text-white"
>

  <!-- Background -->
  <div
    class="absolute inset-0 bg-gradient-to-r
      from-[#08233D]
      via-[#0B2E4F]/95
      to-[#0B2E4F]/60">
  </div>

  <Container>

    <!-- Hero Content -->
    <div
      class="relative min-h-screen flex items-center
        pt-24 pb-16
        lg:pt-20 lg:pb-20"
    >

      <div
        class="grid w-full items-center
          lg:grid-cols-[1.05fr_0.95fr]
          gap-12 lg:gap-16"
      >

        <!-- TEXT -->
        <div>

          <h1
            class="text-5xl lg:text-6xl font-bold leading-[1.08]"
          >
            Especialistas em Climatização
          </h1>

          <p
            class="mt-6 max-w-2xl text-lg lg:text-xl
              text-slate-300 leading-8"
          >
            Desenvolvemos soluções completas em refrigeração industrial,
            frigoríficos, laticínios, centros logísticos, alimentos, bebidas
            e diversos segmentos da indústria.
          </p>

          <!-- BUTTONS -->
          <div
            class="mt-8 flex flex-col sm:flex-row gap-4"
          >

            <a
              href="https://wa.me/5541991127580?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center
                rounded-lg
                bg-[#F58220]
                px-6 py-3.5
                text-white font-semibold
                transition
                hover:bg-[#e87516]"
            >
              Solicitar orçamento
            </a>

            <Button
              href="#servicos"
              variant="secondary"
            >
              Conheça nossos serviços
            </Button>

          </div>

          <!-- NUMBERS -->
          <div
            class="mt-10 grid grid-cols-2 gap-8"
          >

            <div>

              <p
                class="text-4xl font-bold text-[#F58220]"
              >
                20+
              </p>

              <p
                class="mt-1 text-sm text-slate-300"
              >
                Anos de experiência
              </p>

            </div>

            <div>

              <p
                class="text-4xl font-bold text-[#F58220]"
              >
                500+
              </p>

              <p
                class="mt-1 text-sm text-slate-300"
              >
                Projetos realizados
              </p>

            </div>

          </div>

        </div>

        <!-- IMAGE -->
        <div
          class="hidden lg:flex justify-end"
        >

          <img
            src={heroImage.src}
            alt="Refrigeração Industrial"
            class="w-full max-w-2xl rounded-2xl shadow-2xl"
            loading="eager"
          />

        </div>

      </div>

    </div>

  </Container>

</section>