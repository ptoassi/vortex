---
const segmentos = [
    {
        titulo: "Frigoríficos",
        descricao: "Projetos completos para câmaras frias, túneis e processos industriais.",
        imagem: "/images/segments/frigorifico.jpg"
    },
    {
        titulo: "Laticínios",
        descricao: "Controle térmico para produção e armazenamento.",
        imagem: "/images/segments/laticinio.jpg"
    },
    {
        titulo: "Bebidas",
        descricao: "Sistemas de refrigeração para linhas industriais.",
        imagem: "/images/segments/bebidas.jpg"
    },
    {
        titulo: "Centros Logísticos",
        descricao: "Grandes câmaras frigorificadas para distribuição.",
        imagem: "/images/segments/logistica.jpg"
    },
    {
        titulo: "Indústrias",
        descricao: "Projetos personalizados para qualquer segmento.",
        imagem: "/images/segments/industria.jpg"
    },
    {
        titulo: "Supermercados",
        descricao: "Centrais frigoríficas e câmaras de armazenamento.",
        imagem: "/images/segments/supermercado.jpg"
    }
];
---

<section id="segmentos" class="py-24 bg-white">

    <div class="container mx-auto px-6">

        <div class="text-center mb-16">

            <h2 class="text-5xl font-bold text-[#0E2F4F]">
                Segmentos Atendidos
            </h2>

            <p class="mt-5 text-gray-600 max-w-3xl mx-auto">
                Soluções em refrigeração industrial desenvolvidas para diferentes setores do mercado.
            </p>

        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

            {segmentos.map((item) => (

                    <div class="rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 bg-white">

                        <img
                                src={item.imagem}
                                alt={item.titulo}
                                class="h-60 w-full object-cover"
                        />

                        <div class="p-8">

                            <h3 class="text-2xl font-bold text-[#0E2F4F]">
                                {item.titulo}
                            </h3>

                            <p class="mt-3 text-gray-600">
                                {item.descricao}
                            </p>

                        </div>

                    </div>

            ))}

        </div>

    </div>

</section>