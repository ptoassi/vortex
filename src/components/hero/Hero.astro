---
import Container from "../ui/Container.astro";
import HeroButtons from "./HeroButtons.astro";
import HeroStats from "./HeroStats.astro";

import { hero } from "@content/home";

import heroImage from "../../assets/hero/hero-placeholder.webp";
---

<section
  class="relative overflow-hidden bg-[#08233D] text-white">

  <div class="absolute inset-0 bg-gradient-to-r
from-[#08233D]
via-[#0B2E4F]/95
to-[#0B2E4F]/60"></div>

  <Container>

    <div class="relative min-h-screen flex items-center">

      <div class="grid lg:grid-cols-2 gap-14 items-center">

        <div>

<span
  class="inline-flex rounded-full bg-[#F58220] px-4 py-2 text-sm font-medium">

Especialistas em Refrigeração Industrial

</span>

          <h1
            class="mt-8 text-5xl lg:text-6xl font-bold leading-tight">

            {hero.title}

          </h1>

          <p
            class="mt-8 text-xl text-slate-300 leading-8">

            {hero.subtitle}

          </p>

          <HeroButtons />

          <HeroStats />

        </div>

        <div class="hidden lg:flex justify-end">

          <img

            src={heroImage.src}

            alt="Refrigeração Industrial"

            class="w-full max-w-xl rounded-2xl shadow-2xl"

            loading="eager"

          />

        </div>

      </div>

    </div>

  </Container>

</section>