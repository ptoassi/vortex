---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="relative bg-[#0E4E87]">
  <Container>

    <div class="grid min-h-[700px] items-center gap-16 lg:grid-cols-2">

      <div>

        <span class="mb-5 inline-block rounded-full bg-sky-900 px-4 py-2 text-sm font-semibold text-sky-300">
          Refrigeração Industrial
        </span>

        <h1 class="text-5xl font-extrabold leading-tight text-white lg:text-6xl">
          Soluções completas em
          <span class="text-sky-400">
            Refrigeração Industrial
          </span>
        </h1>

        <p class="mt-8 text-lg leading-8 text-slate-300">
          Projetamos, fabricamos e instalamos sistemas completos de refrigeração
          para diversos segmentos industriais.
        </p>

        <div class="mt-10 flex gap-4">

          <Button href="/contato">
            Solicite um orçamento
          </Button>

          <Button
            href="/empresa"
            variant="secondary"
          >
            Saiba mais
          </Button>

        </div>

      </div>

      <div class="hidden lg:block">

        <img
          src="/images/hero.png"
          alt="Sistema de refrigeração industrial"
          class="w-full"
        />

      </div>

    </div>

  </Container>
</section>