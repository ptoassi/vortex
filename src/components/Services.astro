---
const services = [
    {
        icon: "🏗️",
        title: "Projetos",
        description:
            "Desenvolvimento de projetos completos de refrigeração industrial personalizados."
    },
    {
        icon: "❄️",
        title: "Instalação",
        description:
            "Execução completa de sistemas frigoríficos com equipe especializada."
    },
    {
        icon: "🛠️",
        title: "Manutenção",
        description:
            "Manutenção preventiva e corretiva para garantir máxima eficiência."
    },
    {
        icon: "♻️",
        title: "Retrofit",
        description:
            "Modernização de equipamentos e sistemas existentes."
    },
    {
        icon: "📋",
        title: "PMOC",
        description:
            "Planos de manutenção conforme legislação vigente."
    },
    {
        icon: "⚙️",
        title: "Automação",
        description:
            "Controle inteligente e monitoramento de sistemas frigoríficos."
    }
];
---

<section id="servicos" class="bg-[#F8FAFC] py-24">

    <div class="container mx-auto px-6">

        <div class="text-center max-w-3xl mx-auto mb-16">

<span class="text-[#ff7f1f] font-semibold uppercase tracking-widest">
Nossos Serviços
</span>

            <h2 class="mt-4 text-5xl font-bold text-[#0F3155]">
                Soluções completas para refrigeração industrial
            </h2>

            <p class="mt-6 text-gray-600 text-lg">
                Atuamos desde o projeto até a manutenção, oferecendo soluções completas para diversos segmentos industriais.
            </p>

        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

            {
                services.map((service)=> (

                        <div
                                class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition duration-300 border border-gray-100 hover:-translate-y-2">

                            <div class="text-5xl mb-6">
                                {service.icon}
                            </div>

                            <h3 class="text-2xl font-bold text-[#0F3155] mb-4">
                                {service.title}
                            </h3>

                            <p class="text-gray-600 leading-7">
                                {service.description}
                            </p>

                        </div>

                ))
            }

        </div>

    </div>

</section>