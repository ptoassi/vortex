---
const menu = [
  { label: "Home", href: "/" },
  { label: "Empresa", href: "/empresa" },
  { label: "Produtos", href: "/produtos" },
  { label: "Serviços", href: "/servicos" },
  { label: "Contato", href: "/contato" },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">

  <div class="mx-auto flex h-24 max-w-7xl items-center justify-between px-6">

    <!-- Logo -->
    <a href="/" class="flex items-center">
      <img
        src="/images/logo.png"
        alt="Vortex Refrigeração Industrial"
        class="h-14 w-auto"
      />
    </a>

    <!-- Menu -->
    <nav class="hidden lg:flex items-center gap-10">

      {
        menu.map(item => (
          <a
            href={item.href}
            class="font-medium text-slate-700 transition hover:text-sky-600"
          >
            {item.label}
          </a>
        ))
      }

    </nav>

    <!-- Botão -->
    <a
      href="/contato"
      class="hidden rounded-lg bg-sky-600 px-6 py-3 font-semibold text-white transition hover:bg-sky-700 lg:inline-flex"
    >
      Solicite um orçamento
    </a>

  </div>

</header>