---
import Container from "../ui/Container.astro";
---

<header class="fixed inset-x-0 top-0 z-50">

  <Container>

    <div class="mt-5 rounded-xl bg-white/95 backdrop-blur shadow-lg">

      <div class="flex items-center justify-between h-20 px-8">

        <a href="/" class="font-bold text-2xl text-[#0B2E4F]">

          VORTEX

        </a>

          <nav class="hidden lg:flex items-center gap-10">

              <a href="#home" class="hover:text-[#ff7f1f] transition">
                  Home
              </a>

              <a href="#empresa" class="hover:text-[#ff7f1f] transition">
                  Empresa
              </a>

              <a href="#servicos" class="hover:text-[#ff7f1f] transition">
                  Serviços
              </a>

              <a href="#segmentos" class="hover:text-[#ff7f1f] transition">
                  Segmentos
              </a>

              <a href="#projetos" class="hover:text-[#ff7f1f] transition">
                  Projetos
              </a>

              <a href="#clientes" class="hover:text-[#ff7f1f] transition">
                  Clientes
              </a>

              <a href="#contato" class="hover:text-[#ff7f1f] transition">
                  Contato
              </a>

          </nav>

        <a href="https://wa.me/5541991127580?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento." target="_blank" rel="noopener noreferrer"
