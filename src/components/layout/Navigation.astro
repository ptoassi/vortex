---
import { navigation } from "../../config/navigation";
---

<nav>
  <ul class="hidden items-center gap-8 lg:flex">
    {
      navigation.map((item) => (
        <li>
          <a
            href={item.href}
            class="font-medium text-slate-700 transition hover:text-blue-700"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>