---
import Container from "../ui/Container.astro";
---

<footer class="bg-[#0E4E87] text-white py-12">

  <Container>

    <div class="grid md:grid-cols-3 gap-8">

      <div>

        <h3 class="font-bold text-xl">

          Vortex Refrigeração Industrial

        </h3>

        <p class="mt-4 text-slate-300">

          Especialistas em refrigeração industrial.

        </p>

      </div>

      <div>

        <h4 class="font-semibold">

          Contato

        </h4>

        <ul class="space-y-2 mt-4 text-slate-300">

          <li><a href="https://wa.me/5541991127580?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento." target="_blank" rel="noopener noreferrer">(41) 99112-7580</a></li>

          <li><a href="mailto:contato@vortexfrig.com">contato@vortexfrig.com</a></li>

          <li>Curitiba • PR</li>

        </ul>

      </div>

      <div>

        <h4 class="font-semibold">

          Redes Sociais

        </h4>

        <ul class="space-y-2 mt-4">
          <li> </li>
          <li>
            <a
            href="https://www.instagram.com/vortexfrig/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-slate-400 hover:text-[#00A3E0] transition"
          >
            <i class="fa-brands fa-instagram text-2xl"></i>
          </a>&nbsp;&nbsp;
            <a
            href="https://www.facebook.com/vortexfrig"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-slate-400 hover:text-[#00A3E0] transition"
          >
            <i class="fa-brands fa-facebook text-2xl"></i>
          </a>&nbsp;&nbsp;
            <a
            href="https://www.linkedin.com/company/vortexfrig/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-slate-400 hover:text-[#00A3E0] transition"
          >
            <i class="fa-brands fa-linkedin text-2xl"></i>
          </a>
          </li>

        </ul>

      </div>

    </div>

    <div class="border-t border-slate-700 mt-10 pt-6 text-center text-sm text-slate-400">

      © {new Date().getFullYear()} Vortex Refrigeração Industrial

    </div>

  </Container>

</footer>